# virtualenv and bytecode
.venv/
__pycache__/
*.pyc

# generated corpus and index — rebuild with scripts/extract_man.py + build_index.py
data/corpus/*.jsonl
data/index/

# ingested user domains — refetch with scripts/fetch_domain.py and
# scripts/collect_userdocs.sh; the fingerprint that identifies them is tracked
data/corpus/domains/

# GGUF weights — fetch with scripts/fetch_models.py
models/

# server logs and pid files
.run/

# retrieval cache used to split eval into two stages
data/eval/results/*-retrieved.json
.work/

# orchestration layer (ORCH) — machinery, runtime state, and project memory.
# Deliberately untracked: this repo keeps orchestration local to the machine.
# Reinstall with: python3 - ORCH.md <<< the installer block in ORCH.md §0
ORCH.md
CLAUDE.md
.claude/
.orch/
