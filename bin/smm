#!/usr/bin/env bash
# asq / smm - one command for the corpus: no manual server start/stop.
#
#   asq "how do I exclude files listed in a text file from a tar archive"
#   asq ingest --domain notes ~/notes/
#   asq status                 # per-model up/down, starts nothing
#   asq stop                   # stop everything now, instead of waiting SMM_IDLE
#   asq install --name X --prefix DIR
#
# Servers start lazily, one at a time, only as an invocation needs them
# (embedder -> reranker -> generator - see src/smm/daemon.py) and an idle
# reaper stops them SMM_IDLE seconds (default 600) after the last invocation.
#
# Renameable without a code edit: this script resolves its own real path so
# it works via a symlink from any cwd, and takes its displayed name from
# argv[0] - `asq install` just points a new symlink at this file.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
VENV_PYTHON="$ROOT/.venv/bin/python"
DAEMON="$ROOT/src/smm/daemon.py"
NAME="$(basename "$0")"

# src/smm/daemon.py is stdlib-only, so `status`/`stop` - the commands someone
# reaches for when something is broken, including before the venv exists -
# work under whatever python3 is on $PATH. `ask`/`ingest` import smm.* (numpy,
# sqlite-vec, ...) and genuinely need the project venv; those still hard-fail
# with a pointer to the README if it is missing.
STATUS_PYTHON="$VENV_PYTHON"
if [ ! -x "$STATUS_PYTHON" ]; then
  STATUS_PYTHON="$(command -v python3 || true)"
fi

usage() {
  cat >&2 <<EOF
usage: $NAME ["question..."]              ask the corpus (default subcommand)
       $NAME ingest [options] path...     add material to an index
       $NAME status                       per-model up/down; starts nothing
       $NAME stop                         stop all servers and the reaper now
       $NAME install [--name X] [--prefix DIR]
                                           symlink DIR/X -> this launcher
                                           (defaults: X=asq, DIR=~/.local/bin)

Flags this wrapper does not recognise pass straight through to the wrapped
script (scripts/ask.py or scripts/ingest.py).
EOF
}

cmd_install() {
  local name="asq" prefix="$HOME/.local/bin"
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)   name="$2"; shift 2 ;;
      --prefix) prefix="$2"; shift 2 ;;
      *) echo "$NAME install: unknown option $1" >&2; return 1 ;;
    esac
  done
  mkdir -p "$prefix"
  ln -sf "$SELF" "$prefix/$name"
  echo "installed: $prefix/$name -> $SELF"
  case ":${PATH:-}:" in
    *":$prefix:"*) ;;
    *) echo "warning: $prefix is not on \$PATH - add it, e.g. export PATH=\"$prefix:\$PATH\"" >&2 ;;
  esac
}

sub="ask"
if [ $# -gt 0 ]; then
  case "$1" in
    ask|ingest|status|stop|install) sub="$1"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) : ;;  # not a subcommand keyword - falls through to `ask` untouched
  esac
fi

if [ "$sub" = "install" ]; then
  cmd_install "$@"
  exit $?
fi

case "$sub" in
  status)
    if [ -z "$STATUS_PYTHON" ]; then
      echo "$NAME: no python3 found on \$PATH" >&2
      exit 1
    fi
    exec "$STATUS_PYTHON" "$DAEMON" status ;;
  stop)
    if [ -z "$STATUS_PYTHON" ]; then
      echo "$NAME: no python3 found on \$PATH" >&2
      exit 1
    fi
    exec "$STATUS_PYTHON" "$DAEMON" stop ;;
  ask|ingest)
    if [ ! -x "$VENV_PYTHON" ]; then
      echo "$NAME: no venv at $VENV_PYTHON - see README (python3 -m venv --copies .venv && ...)" >&2
      exit 1
    fi
    if [ "$sub" = "ask" ] && [ $# -eq 0 ]; then usage; exit 1; fi
    exec "$VENV_PYTHON" "$DAEMON" run "$VENV_PYTHON" "$ROOT/scripts/$sub.py" -- "$@" ;;
esac
